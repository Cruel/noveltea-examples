{
  "schema": "noveltea.project.workspace",
  "schemaVersion": 1,
  "project": {
    "id": "verbs",
    "name": "Verbs",
    "version": "0.1.0",
    "author": "NovelTea",
    "description": "Minimal Verb, Interaction, and Command Builder example."
  },
  "settings": {
    "ui": { "systemLayouts": {} },
    "inventory": { "defaultLayout": null },
    "interaction": { "defaultVerbMenuLayout": null },
    "text": { "defaultFont": null, "fontStack": [] },
    "titleScreen": {
      "titleImage": null,
      "showProjectTitle": true,
      "showAuthor": false,
      "subtitle": "",
      "startLabel": "Start"
    },
    "app": {
      "displayName": "Verbs",
      "localized": {},
      "applicationId": "org.noveltea.examples.verbs",
      "saveNamespace": "org.noveltea.examples.verbs",
      "versionName": "0.1.0",
      "icon": { "$ref": { "collection": "assets", "id": "icon" } },
      "launchImage": null,
      "desktop": {},
      "web": {},
      "android": {}
    },
    "display": {
      "referenceResolution": { "width": 1920, "height": 1080 },
      "worldRasterPolicy": "capped",
      "barColor": "#000000"
    },
    "accessibility": {
      "uiScale": { "enabled": true, "minimum": 1, "maximum": 2 },
      "textScale": { "enabled": true, "minimum": 1, "maximum": 2 }
    },
    "audio": {
      "purposes": {
        "music": { "volume": 1, "muted": false },
        "ambience": { "volume": 1, "muted": false },
        "voice": { "volume": 1, "muted": false },
        "sound-effect": { "volume": 1, "muted": false },
        "ui-sound": { "volume": 1, "muted": false }
      },
      "voiceDucking": { "enabled": false, "musicGain": 0.5, "ambienceGain": 0.5 }
    },
    "presentation": {
      "roomNavigationTransition": { "kind": "cut", "durationMs": 0, "color": null, "skippable": true }
    }
  },
  "export": {
    "runtime": {
      "id": "runtime-default",
      "label": "Runtime Package",
      "kind": "runtime",
      "outputPath": "",
      "includeChecksums": true,
      "stripEditorData": true,
      "stripShaderSources": true,
      "compileShadersBeforeExport": true,
      "shaderVariants": ["glsl-120", "essl-100", "essl-300"],
      "excludeUnusedAssets": true,
      "includeShaderSources": false,
      "includeTests": false,
      "previewAfterExport": false,
      "localization": { "locales": ["en"], "defaultLocale": "en", "quality": "development" }
    },
    "profiles": [
      {
        "format": "noveltea.platform-export-profile",
        "id": "web-threaded",
        "label": "Web Threaded",
        "buildFlavor": "release",
        "compression": "default",
        "includeDebugSymbols": false,
        "excludeUnusedAssets": true,
        "includeShaderSources": false,
        "assetMemory": { "kind": "builtin", "preset": "balanced" },
        "localization": { "locales": ["en"], "defaultLocale": "en", "quality": "release" },
        "target": "web",
        "architecture": "wasm32",
        "packageAccess": "web-fetch",
        "web": {
          "artifact": "directory-zip",
          "threaded": true,
          "pwa": true,
          "display": "standalone",
          "basePath": "/",
          "serviceWorker": "disabled"
        }
      }
    ],
    "assetMemoryPolicies": []
  },
  "bootstrapModule": { "$ref": { "collection": "scripts", "id": "bootstrap" } },
  "entrypoint": { "kind": "room", "id": "workbench" },
  "inventories": [{ "id": "inventory", "label": "Inventory" }],
  "interactableInstances": {
    "switch-1": {
      "id": "switch-1",
      "definition": { "$ref": { "collection": "interactables", "id": "switch" } },
      "location": { "kind": "room", "room": { "$ref": { "collection": "rooms", "id": "workbench" } } },
      "enabled": true,
      "visible": true,
      "quantity": 1,
      "traits": { "add": [], "remove": [] },
      "localProperties": [],
      "featureOverrides": []
    }
  }
}
